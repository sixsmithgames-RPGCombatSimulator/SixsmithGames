# Runtime must be either "preview" for local sample-data review or "connected"
# for a Clerk-authenticated Vercel deployment backed by Neon Postgres.
OPERATIONS_RUNTIME_MODE=preview

# This address is enforced again in the server-side data access layer. The
# Clerk production application should also use Restricted sign-up mode.
OPERATIONS_ALLOWED_EMAIL=sexsmith2005@gmail.com

# Required only when OPERATIONS_RUNTIME_MODE=connected.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
DATABASE_URL=

# Read-only aggregate reporting for the public `sixsmithgames` Vercel project.
# The token is server-only and must never use a NEXT_PUBLIC_ prefix. Create a
# team-scoped access token with the minimum available read access and store it
# as a sensitive Vercel environment variable.
VERCEL_ANALYTICS_READ_TOKEN=
VERCEL_ANALYTICS_TEAM_ID=team_MV7H5Yr78mJD46i3lMjAMjOc
VERCEL_ANALYTICS_PROJECT_ID=prj_4q3lkO9SwySPux5Br1TaLKbYv0eD
VERCEL_ANALYTICS_PROJECT_NAME=sixsmithgames
VERCEL_ANALYTICS_DASHBOARD_URL=https://vercel.com/sixsmithgames-rpgcombatsimulators-projects/sixsmithgames/analytics

# UTM dimensions require Vercel Web Analytics Plus or Enterprise. Keep this
# false unless that capability and its cost are explicitly approved.
VERCEL_ANALYTICS_UTM_SOURCES_ENABLED=false

# Keep false until Vercel custom-event plan eligibility and cost are approved.
VERCEL_ANALYTICS_CUSTOM_EVENTS_ENABLED=false

# Existing Sixsmith Games billing account. Operations validates read access and
# does not enable Stripe writes from the Settings workspace.
STRIPE_SECRET_KEY=

# Optional until an Operations-specific Stripe webhook route is implemented
# and verified. Do not reuse an unrelated endpoint secret.
STRIPE_WEBHOOK_SECRET=

# Product application origins and least-privilege read credentials.
GMC_BASE_URL=https://gmcraft.sixsmithgames.com
VCS_SERVICE_BASE_URL=https://virtualcombatsimulator-production.up.railway.app
VCS_SERVICE_API_KEY=
VCS_SERVICE_OWNER_ID=

# Source-authoritative operational activity. Leave the ledger disabled until
# the migration is applied and at least one product feed passes synthetic and
# internal-account reconciliation. Auto-sync runs when Product Activity opens.
PRODUCT_ACTIVITY_LEDGER_ENABLED=false
PRODUCT_ACTIVITY_AUTO_SYNC_ENABLED=false
PRODUCT_ACTIVITY_STALE_AFTER_MINUTES=60
PRODUCT_ACTIVITY_SOURCES_JSON=[]

# Example source descriptor (keep it on one JSON line when enabled):
# [{"key":"vcs","label":"VCS authoritative feed","baseUrl":"https://virtualcombatsimulator-production.up.railway.app","environment":"production","productSlugs":["virtual-combat-simulator"],"tokenEnvironmentVariable":"VCS_PRODUCT_ACTIVITY_READ_TOKEN","enabled":true}]
VCS_PRODUCT_ACTIVITY_READ_TOKEN=
